# ========================================================
# Baba Dugdheswar Enterprise (BDE) - Environment Configuration
# ========================================================

# 1. Database Configuration (Neon Cloud PostgreSQL)
# Required format: postgresql+psycopg://<user>:<password>@<neon-hostname>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_NEON_PASSWORD@ep-sweet-shape-b3jn07iv-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Staff & Manager Security Passcodes
# Never expose these in frontend JS files. Set these in Render Environment Variables.
STAFF_PASSCODE=BDE@1234
ADMIN_PASSCODE=Dip@1993
SECRET_KEY=bde-security-onda-bankura-2026

# 3. Android Keystore Release Signing (Local Builds)
# For local builds, set these in key.properties or as system environment variables.
# For CI/CD, set ANDROID_KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS, and KEY_PASSWORD in GitHub Secrets.
KEYSTORE_FILE=my-release-key.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password

# 4. Server Port
PORT=8000
